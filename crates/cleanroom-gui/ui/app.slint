import { VerticalBox, HorizontalBox, GroupBox, Button, Slider, CheckBox, ComboBox, Switch, ScrollView } from "std-widgets.slint";

// Health, mirroring cleanroom_ipc::Health. Kept as a plain int rather than a Slint enum
// because it crosses the D-Bus boundary as a string and the Rust side does the mapping
// once, in one place.
//   0 nominal   1 degraded   2 failed   3 idle

// Helper, not a window: deliberately not exported, or the compiler warns that no code
// will be generated for it.
component StatusRow inherits HorizontalBox {
    in property <string> label;
    in property <int> health: 3;
    in property <string> detail;

    spacing: 8px;
    Text {
        text: root.label;
        font-weight: 700;
        width: 56px;
        vertical-alignment: center;
    }
    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        y: (parent.height - self.height) / 2;
        background: root.health == 0 ? #3fb950
                  : root.health == 1 ? #d29922
                  : root.health == 2 ? #f85149
                  : #6e7681;
    }
    Text {
        text: root.detail;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component AppWindow inherits Window {
    title: "Cleanroom";
    preferred-width: 560px;
    preferred-height: 620px;
    icon: @image-url("../icons/cleanroom.png");

    // --- state pushed from Rust ---
    in property <int> video-health: 3;
    in property <string> video-detail: "connecting…";
    in property <int> audio-health: 3;
    in property <string> audio-detail: "connecting…";
    in property <string> gpu-adapter: "—";
    in property <string> vcam-path: "—";

    in property <float> fps: 0;
    in property <float> decode-ms: 0;
    in property <float> gpu-ms: 0;
    in property <float> matting-ms: 0;
    in property <int> dropped: 0;
    in property <int> matte-rejected: 0;
    in property <int> consumers: 0;
    in property <float> mic-in-db: -100;
    in property <float> mic-out-db: -100;

    in property <bool> connected: false;

    // Device pickers. Populated from ListCameras / ListMicrophones.
    in property <[string]> camera-names: [];
    in property <[string]> microphone-names: [];
    in-out property <int> camera-index: -1;
    in-out property <int> microphone-index: -1;

    in property <image> preview-frame;
    in property <bool> preview-running: false;
    in-out property <string> background-image: "";
    in property <string> autostart-mechanism: "";
    in property <string> autostart-instruction: "";
    in-out property <bool> autostart-on: false;

    // --- controls, two-way ---
    in-out property <int> background-mode: 1;   // 0 off, 1 blur, 2 replace, 3 remove
    in-out property <float> blur-strength: 0.6;
    in-out property <bool> mirror: false;
    in-out property <bool> denoise: true;
    in-out property <float> attenuation: 40;

    callback set-camera(string);
    callback set-microphone(string);
    callback choose-background-image();
    callback clear-background-image();
    callback set-autostart(bool);
    callback set-background(int);
    callback set-blur(float);
    callback set-mirror(bool);
    callback set-denoise(bool);
    callback set-attenuation(float);
    callback quit-daemon();

    // Wrapped in a ScrollView because the content is taller than the window on a
    // default-sized launch — without it the Performance panel is simply cut off, with no
    // indication that anything is missing.
    ScrollView {
        VerticalBox {
        padding: 16px;
        spacing: 14px;

        // Degradation is surfaced at the top and unmissable. The entire point of tracking
        // health explicitly is that somebody sees it.
        if !root.connected || root.video-health == 1 || root.video-health == 2
                           || root.audio-health == 1 || root.audio-health == 2 : Rectangle {
            background: !root.connected ? #6e768120 : #d2992220;
            border-radius: 6px;
            border-width: 1px;
            border-color: !root.connected ? #6e7681 : #d29922;
            height: banner.preferred-height + 16px;
            banner := VerticalBox {
                padding: 8px;
                Text {
                    text: !root.connected
                        ? "Not connected to the Cleanroom daemon. Start it with: cleanroomd"
                        : "Running degraded — see the detail below.";
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "Status";
            VerticalBox {
                spacing: 6px;
                StatusRow { label: "Video"; health: root.video-health; detail: root.video-detail; }
                StatusRow { label: "Audio"; health: root.audio-health; detail: root.audio-detail; }
                HorizontalBox {
                    Text { text: "GPU"; font-weight: 700; width: 56px; }
                    Text { text: root.gpu-adapter; wrap: word-wrap; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "Camera"; font-weight: 700; width: 56px; }
                    Text { text: root.vcam-path; horizontal-stretch: 1; }
                }
            }
        }

        GroupBox {
            title: "Preview";
            VerticalBox {
                padding: 0px;
                spacing: 6px;
                Rectangle {
                    height: 180px;
                    background: #1a1a1a;
                    border-radius: 4px;
                    clip: true;
                    Image {
                        source: root.preview-frame;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }
                    Text {
                        visible: !root.preview-running;
                        text: "waiting for the virtual camera…";
                        color: #888;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                // Said plainly rather than left to be discovered: the preview is a real
                // consumer of the virtual camera, so it keeps the capture awake.
                Text {
                    text: "This is what other apps see. Keeping it open holds the camera awake.";
                    color: #888;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "Devices";
            VerticalBox {
                padding: 0px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    Text { text: "Camera"; width: 76px; vertical-alignment: center; }
                    ComboBox {
                        model: root.camera-names;
                        current-index: root.camera-index;
                        enabled: root.camera-names.length > 0;
                        horizontal-stretch: 1;
                        selected(value) => { root.set-camera(value); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    Text { text: "Microphone"; width: 76px; vertical-alignment: center; }
                    ComboBox {
                        model: root.microphone-names;
                        current-index: root.microphone-index;
                        enabled: root.microphone-names.length > 0;
                        horizontal-stretch: 1;
                        selected(value) => { root.set-microphone(value); }
                    }
                }
            }
        }

        GroupBox {
            title: "Background";
            VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    Button {
                        text: "Off";
                        primary: root.background-mode == 0;
                        clicked => { root.background-mode = 0; root.set-background(0); }
                    }
                    Button {
                        text: "Blur";
                        primary: root.background-mode == 1;
                        clicked => { root.background-mode = 1; root.set-background(1); }
                    }
                    Button {
                        text: "Replace";
                        primary: root.background-mode == 2;
                        clicked => { root.background-mode = 2; root.set-background(2); }
                    }
                    Button {
                        text: "Green";
                        primary: root.background-mode == 3;
                        clicked => { root.background-mode = 3; root.set-background(3); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Strength"; width: 70px; vertical-alignment: center; }
                    Slider {
                        minimum: 0; maximum: 1;
                        value <=> root.blur-strength;
                        enabled: root.background-mode == 1;
                        // Applied on the very next frame — no restart, no dropped frames.
                        released(v) => { root.set-blur(v); }
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Math.round(root.blur-strength * 100) + "%";
                        width: 44px;
                        vertical-alignment: center;
                    }
                }
                HorizontalBox {
                    CheckBox {
                        text: "Mirror my video";
                        checked <=> root.mirror;
                        toggled => { root.set-mirror(self.checked); }
                    }
                }
            }
        }

        GroupBox {
            title: "Microphone";
            VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    Switch {
                        text: "Noise suppression (DeepFilterNet)";
                        checked <=> root.denoise;
                        toggled => { root.set-denoise(self.checked); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Strength"; width: 70px; vertical-alignment: center; }
                    Slider {
                        // Capped below 100 deliberately: DeepFilterNet reads >= 100 dB as
                        // "no limit at all", so a slider that reached it would silently
                        // turn the limiter off at exactly the point a user expects maximum.
                        minimum: 6; maximum: 90;
                        value <=> root.attenuation;
                        enabled: root.denoise;
                        released(v) => { root.set-attenuation(v); }
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Math.round(root.attenuation) + " dB";
                        width: 44px;
                        vertical-alignment: center;
                    }
                }
                // The gap between the two is the suppression actually being applied,
                // which is more informative than either number alone.
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Level"; width: 70px; vertical-alignment: center; }
                    Text {
                        text: Math.round(root.mic-in-db) + " dBFS in  →  "
                            + Math.round(root.mic-out-db) + " dBFS out";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        GroupBox {
            title: "Startup";
            VerticalBox {
                padding: 0px;
                spacing: 6px;
                Switch {
                    text: "Start Cleanroom with my session";
                    checked: root.autostart-on;
                    enabled: root.autostart-instruction == "";
                    toggled => { root.set-autostart(self.checked); }
                }
                // Shown when this session supports neither systemd nor XDG autostart. The
                // switch is disabled in that case rather than pretending to work.
                Text {
                    visible: root.autostart-instruction != "";
                    text: root.autostart-instruction;
                    color: #d08770;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "Performance";
            VerticalBox {
                padding: 0px;
                spacing: 6px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 18px;
                    Text { text: Math.round(root.fps * 10) / 10 + " fps"; }
                    Text { text: "decode " + Math.round(root.decode-ms * 100) / 100 + " ms"; }
                    Text { text: "gpu " + Math.round(root.gpu-ms * 100) / 100 + " ms"; }
                    // Matting is usually the largest single cost in gpu-ms, so showing gpu
                    // alone makes the expensive part look free.
                    Text { text: "matting " + Math.round(root.matting-ms * 100) / 100 + " ms"; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.consumers == 0
                        ? "idle — camera released"
                        : root.consumers + " app(s) using the camera";
                }
                // Both hidden until non-zero. A counter permanently reading 0 is noise, and
                // noise is what stops anyone noticing the moment it stops reading 0.
                Text {
                    visible: root.dropped > 0;
                    text: root.dropped + " frame(s) dropped in the last second — the camera is outrunning the pipeline";
                    wrap: word-wrap;
                    color: #d08770;
                }
                Text {
                    visible: root.matte-rejected > 0;
                    text: root.matte-rejected + " matte(s) rejected as degenerate since startup";
                    wrap: word-wrap;
                    color: #d08770;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
        }
    }
}

// The tray icon is a separate top-level component: it has no window of its own, and the
// only UI it presents is its menu.
//
// Whether it appears at all depends entirely on the desktop. GNOME ships no SNI host, and
// a bare wlroots session often has none either. So the tray is treated as decoration —
// closing the window quits the GUI rather than hiding it into a tray that may not exist,
// and every action here is also reachable from `cleanroom-ctl`.
export component Tray inherits SystemTrayIcon {
    icon: @image-url("../icons/cleanroom.png");
    tooltip: "Cleanroom";

    callback show-window();
    callback toggle-blur();
    callback toggle-denoise();
    callback quit();

    in property <bool> blur-on: true;
    in property <bool> denoise-on: true;

    Menu {
        MenuItem {
            title: "Open Cleanroom";
            activated => { root.show-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.blur-on ? "Background blur: on" : "Background blur: off";
            activated => { root.toggle-blur(); }
        }
        MenuItem {
            title: root.denoise-on ? "Noise suppression: on" : "Noise suppression: off";
            activated => { root.toggle-denoise(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
